; Engine configuration file.
config_version=5

[application]

config/name="Fathom Reef"
config/description="A cozy underwater reef full of cute little fish (Quest, OpenXR)"
run/main_scene="res://main.tscn"
run/main_scene.phone="res://phone.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[display]

window/handheld/orientation.phone=4

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=90
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/enabled.phone=false
openxr/foveation_level=3
openxr/foveation_dynamic=true
shaders/enabled=true
